@inherits LayoutComponentBase

<div class="app">

    <!-- SIDEBAR -->
    <div class="sidebar">
        <div class="logo">
            🔴 PokeAdmin
        </div>

        <nav>
            <NavLink href="/pokemons">🏠 Pokemons</NavLink>
            <NavLink href="/abilities">⚡ Abilities</NavLink>
            <NavLink href="/egggroups">🥚 Egg Groups</NavLink>
            <NavLink href="/gameversions">🎮 Game Versions</NavLink>
            <NavLink href="/growthrates">📈 Growth Rates</NavLink>
            <NavLink href="/moves">⚔️ Moves</NavLink>
            <NavLink href="/stattype">📊 Stat Types</NavLink>
            <NavLink href="/types">⚡ Types</NavLink>
            <NavLink href="/login">🚪 Logout</NavLink>
        </nav>
    </div>

    <!-- MAIN -->
    <div class="main">
        <div class="topbar">
            <span>Pokemon Admin Panel</span>
        </div>

        <div class="content">
            @Body
        </div>
    </div>

</div>

<style>
    .app {
        display: flex;
        height: 100vh;
    }

    /* SIDEBAR */
    .sidebar {
        width: 220px;
        background: #ff3b3b;
        color: white;
        display: flex;
        flex-direction: column;
        padding: 15px;
    }

    .logo {
        font-size: 20px;
        font-weight: bold;
        margin-bottom: 20px;
    }

    /* MENU */
    .sidebar nav {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .sidebar a {
        color: white;
        text-decoration: none;
        padding: 8px;
        border-radius: 6px;
    }

        .sidebar a.active {
            background: rgba(255,255,255,0.2);
        }

        .sidebar a:hover {
            background: rgba(255,255,255,0.2);
        }

    /* MAIN */
    .main {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    /* TOPBAR */
    .topbar {
        height: 50px;
        background: white;
        border-bottom: 2px solid #ff3b3b;
        display: flex;
        align-items: center;
        padding: 0 15px;
        font-weight: bold;
    }

    /* CONTENT */
    .content {
        padding: 20px;
        background: #f5f5f5;
        height: 100%;
        overflow: auto;
    }
</style>